{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bedaya-enterprise-agent",
  "main": "worker.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "kv_namespaces": [
    {
      "binding": "BEDAYA_KV_PROD",
      "id": "ddbe4f4fc4be4cf3adcac516df38f2ee"
    }
  ],
  "queues": {
    "producers": [
      { "queue": "zernio-events", "binding": "EVENTS_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "zernio-events",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "zernio-events-dlq"
      },
      {
        "queue": "zernio-events-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 30
      }
    ]
  }
}
