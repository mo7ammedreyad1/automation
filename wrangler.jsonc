{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bedaya-gateway-worker",
  "main": "worker.js",
  "compatibility_date": "2026-03-01",
  "kv_namespaces": [
    {
      "binding": "ZERNIO_KV",
      "id": "ff883e9f60784e1fb7ae4e0229d9c9e8"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "zernio-events",
        "binding": "EVENTS_QUEUE"
      }
    ]
  }
}
